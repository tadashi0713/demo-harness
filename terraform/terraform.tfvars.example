# cp terraform.tfvars.example terraform.tfvars して必要な値だけ変更する
# image_tag はデプロイのたびに -var image_tag=... で渡す
#
# デフォルト値は検証環境向けにコストを優先している
# （Graviton のスポット 1 台、NAT Gateway なし、2 AZ、RDS は削除保護なし）

region  = "ap-northeast-1"
project = "tadashi-demo"

# 自分の IP だけに EKS API とアプリへのアクセスを絞る場合
# cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]
# app_allowed_cidrs                    = ["203.0.113.10/32"]

# 独自ドメインの ACM 証明書を指定すると HTTPS (443) で公開する
# acm_certificate_arn = "arn:aws:acm:ap-northeast-1:123456789012:certificate/..."

# x86_64 のノードにする場合（イメージも --platform linux/amd64 でビルドする）
# node_ami_type       = "AL2023_x86_64_STANDARD"
# node_instance_types = ["t3.medium", "t3a.medium"]

# 本番相当の構成にする場合
# az_count                  = 3
# enable_nat_gateway        = true
# single_nat_gateway        = false
# node_capacity_type        = "ON_DEMAND"
# node_min_size             = 2
# node_desired_size         = 2
# app_replicas              = 2
# cluster_enabled_log_types = ["audit", "api", "authenticator"]
# db_multi_az               = true
# db_instance_class         = "db.t4g.small"
# db_backup_retention_days  = 7
# db_deletion_protection    = true
# db_skip_final_snapshot    = false
# ecr_force_delete          = false
